	measure UltimaAtt =
			
			VAR DataHora =
			    MAXX({
			            MAX('fPonto'[DataCarga]),
			            MAX('fViagem'[CreatedAt]),
			            MAX('fBoleto'[CreatedAt]),
			            MAX('fCartao_recarga'[CreatedAt]),
			            MAX('fSiteAcesso'[Date]),
			            MAX('fNovos_cartoes_recarga'[CreatedAt]),
			            MAX('fPedido_item'[CreatedAt]),
			            MAX('fPedido_recarga_mobile_topup'[CreatedAt])
			        },
			        [Value]
			    )
			RETURN
			    "Última Atualização: " & FORMAT(DataHora, "dd/MM/yyyy") & "."
		lineageTag: a6d1a4ff-b905-4925-a4a5-6c578a293e2e

	measure 'Nunca Acessaram' = ```
			
			// 1. Identifica os IDs das campanhas que estão no contexto (filtradas no período atual)
			VAR CampanhasAtivas = VALUES('fSiteAcesso'[CampanhaId])
			
			// 2. Lista os usuários vinculados a essas campanhas específicas
			VAR UsuariosDasCampanhas = 
			    CALCULATETABLE(
			        VALUES(dUsuario[CPF]),
			        TREATAS(CampanhasAtivas, dCampanha[Id]), // Transfere o filtro da tabela Fato para a Dimensão
			        CROSSFILTER(dUsuario[Id], dUsuarioCampanha[UsuarioId], BOTH), // Força o filtro chegar nos Usuários
			        REMOVEFILTERS(dCalendario) // Garante que vai listar todos os usuários da campanha, independente da data
			    )
			
			// 3. Lista todos os usuários que já acessaram o site alguma vez na vida (histórico completo)
			VAR UsuariosComAcesso = 
			    CALCULATETABLE(
			        VALUES('fSiteAcesso'[CPF]),
			        REMOVEFILTERS(dCalendario)
			    )
			
			// 4. Subtrai quem já acessou da lista de usuários das campanhas ativas.
			VAR UsuariosSemAcesso = EXCEPT(UsuariosDasCampanhas, UsuariosComAcesso)
			
			RETURN
			    COUNTROWS(UsuariosSemAcesso)
			```
		formatString: #,0
		displayFolder: Acessos
		lineageTag: 0a759f15-eb1f-49e3-9670-11844f748c23

