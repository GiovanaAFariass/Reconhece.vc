	measure 'Último Acesso' = MAX('fSiteAcesso'[Date])
		formatString: Short Date
		displayFolder: Acessos
		lineageTag: 18ba9b19-422a-44b0-8403-8470e6d12943

	measure 'Último Acesso (30 Dias)' = ```
			
			VAR DataRef = MAX(dCalendario[Date])
			VAR DataCorte = DataRef - 30
			
			// 1. Identifica os IDs das campanhas que estão no contexto (filtradas no período atual)
			VAR CampanhasDoPeriodo = VALUES('fSiteAcesso'[CampanhaId])
			
			// 2. Lista os CPFs vinculados a essas campanhas específicas (olhando o histórico até a data atual)
			VAR UsuariosDasCampanhas = 
			    CALCULATETABLE(
			        VALUES('fSiteAcesso'[CPF]),
			        REMOVEFILTERS(dCalendario),
			        dCalendario[Date] <= DataRef,
			        CampanhasDoPeriodo
			    )
			
			// 3. Lista os CPFs que tiveram acesso ao site nos últimos 30 dias
			VAR UsuariosRecentes = 
			    CALCULATETABLE(
			        VALUES('fSiteAcesso'[CPF]),
			        REMOVEFILTERS(dCalendario),
			        dCalendario[Date] > DataCorte,
			        dCalendario[Date] <= DataRef
			    )
			
			// 4. Subtrai os usuários recentes da lista de usuários das campanhas. Quem sobra é inativo.
			VAR UsuariosInativos = EXCEPT(UsuariosDasCampanhas, UsuariosRecentes)
			
			RETURN
			    COUNTROWS(UsuariosInativos)
			```
		formatString: #,0
		displayFolder: Acessos
		lineageTag: 61a8c5da-199c-4bc5-b0f4-4833b62500c3

	measure 'Último Acesso (30 Dias) VAR' = ```
			
			VAR DataMax = MAX(dCalendario[Date])
			VAR DataMin = MIN(dCalendario[Date])
			VAR Dias = DATEDIFF(DataMin, DataMax, DAY) + 1
			VAR DataMinAnt = DataMin - Dias
			VAR DataMaxAnt = DataMin - 1
			
			VAR ValorAtual = [Último Acesso (30 Dias)]
			VAR ValorAnterior = 
			    CALCULATE(
			        [Último Acesso (30 Dias)],
			        REMOVEFILTERS(dCalendario),
			        dCalendario[Date] >= DataMinAnt && dCalendario[Date] <= DataMaxAnt
			    )
			    
			VAR Variacao = DIVIDE(ValorAtual - ValorAnterior, ValorAnterior)
			VAR Seta = IF(Variacao > 0, "▲", IF(Variacao < 0, "▼", "►"))
			
			RETURN
			    IF(
			        ISBLANK(ValorAnterior), 
			        "-", 
			        Seta & " " & FORMAT(ABS(Variacao), "0%")
			    )
			```
		displayFolder: Acessos
		lineageTag: 9c7b213a-693b-4246-90bc-c4d7c8f92b16

	measure 'Dias Inatividade' =
			
			VAR DataRef = CALCULATE(MAX(dCalendario[Date]), ALLSELECTED(dCalendario))
			VAR UltimoAcesso = MAX('fSiteAcesso'[Date])
			RETURN
			    IF(
			        NOT ISBLANK(UltimoAcesso),
