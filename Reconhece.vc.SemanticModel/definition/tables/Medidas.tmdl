	measure 'Produtos VAR' = ```
			
			VAR DataMax = MAX(dCalendario[Date])
			VAR DataMin = MIN(dCalendario[Date])
			VAR Dias = DATEDIFF(DataMin, DataMax, DAY) + 1
			VAR DataMinAnt = DataMin - Dias
			VAR DataMaxAnt = DataMin - 1
			
			VAR ValorAtual = [Produtos Valor]
			VAR ValorAnterior = 
			    CALCULATE(
			        [Produtos Valor],
			        REMOVEFILTERS(dCalendario),
			        dCalendario[Date] >= DataMinAnt && dCalendario[Date] <= DataMaxAnt
			    )
			    
			VAR Variacao = DIVIDE(ValorAtual - ValorAnterior, ValorAnterior)
			VAR Seta = IF(Variacao > 0, "▲", IF(Variacao < 0, "▼", "►"))
			
			RETURN
			    IF(
			        ISBLANK(ValorAnterior), 
			        "-", 
			        Seta & " " & FORMAT(ABS(Variacao), "0%")
			    )
			```
		displayFolder: Resgates
		lineageTag: ccbcd70c-6c1a-46bc-b371-0aede53a768e

