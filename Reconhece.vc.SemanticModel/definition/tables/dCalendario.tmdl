	partition dCalendario = calculated
		mode: import
		source = ```
				
				VAR DataMinimaFixa = DATE(2022, 1, 1)
				
				VAR DataMaximaGeral = 
				    MAXX({
				            MAX('fPonto'[DataCarga]),
				            MAX('fViagem'[CreatedAt]),
				            MAX('fBoleto'[CreatedAt]),
				            MAX('fCartao_recarga'[CreatedAt]),
				            MAX('fSiteAcesso'[Date]),
				            MAX('fNovos_cartoes_recarga'[CreatedAt]),
				            MAX('fPedido_item'[CreatedAt]),
				            MAX('fPedido_recarga_mobile_topup'[CreatedAt])
				        },
				        [Value]
				    )
				
				RETURN
				    ADDCOLUMNS(
				        CALENDAR(DataMinimaFixa, DataMaximaGeral),
				        "Ano", YEAR([Date]),
				        "Mês", MONTH([Date]),
				        "Dia", DAY([Date]),
				        "Trimestre", "T" & FORMAT([Date], "Q"),
				        "Mês Abr.", UPPER(FORMAT([Date], "MMM")),
				        "Dia da Semana", FORMAT([Date], "dddd"),
				        "Dia da Semana Num", WEEKDAY([Date], 2)
				    )
				```

	annotation PBI_Id = ef4bb709bccd4fee986f86117fbddf63

